#!/bin/sh

# Ensure persistent installation of ZeroTier for UniFi OS >2.0 devices

# User Modifiable Variables (DATA_DIR should be within /data/___ to persist)
DEBUG=1				        # Shows output to terminal if TRUE
UTIL_DIR='/data/unifios-utils'
DATA_DIR="$UTIL_DIR/.config"         	# Set persistent folder location

# Non-User Modifiable Variables (strongly recommend not modifying)
ZT_DIR=/var/lib/zerotier-one	        # Location for ZeroTier config
ZT_SERVICE="$ZT_DIR/zt_upgrade.service"
ZT_TIMER="$ZT_DIR/zt_upgrade.timer"
SYSD_SERVICE='/etc/systemd/system/zt_upgrade.service'
SYSD_TIMER='/etc/systemd/system/zt_upgrade.timer'
APT_FILE='/etc/apt/sources.list.d/zerotier.list'

DEBIAN_RELEASE=$(awk -F'[" ]' '/VERSION=/{print $3}'  /etc/os-release | tr -cd '[[:alnum:]]._-' )

# Function to safely block until the apt/dpkg lock is released
wait_for_apt() {
  if [ $DEBUG -eq 1 ]; then
    echo "Checking for background apt/dpkg locks..."
  fi
  # Loop while fuser detects processes holding the dpkg frontend lock or apt lists lock
  while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 || fuser /var/lib/apt/lists/lock >/dev/null 2>&1; do
    if [ $DEBUG -eq 1 ]; then
      echo "Apt or Dpkg lock is active. Waiting 5 seconds..."
    fi
    sleep 5
  done
  if [ $DEBUG -eq 1 ]; then
    echo "Locks are clear. Proceeding with apt execution."
  fi
}

# Command line arguments:
#   None ($# == 0): Execute the installation routine
#   upgrade ($1 == upgrade): Execute the upgrade routine

# Check if there are any command line arguments
if [ $# -eq 0 ]; then

  # Wait until any conflicting boot time apt tasks finish
  wait_for_apt

  # Overwrite contents of apt file, ensuring it's always there
  echo "deb [signed-by=/etc/apt/trusted.gpg.d/zerotier.com.gpg] http://download.zerotier.com/debian/$DEBIAN_RELEASE $DEBIAN_RELEASE main" > $APT_FILE

  # Ensure the keys and pinning are set up correctly
  if [ ! -f /etc/apt/trusted.gpg.d/zerotier.com.gpg ]; then
     curl -fsSL 'https://raw.githubusercontent.com/zerotier/ZeroTierOne/master/doc/contact%40zerotier.com.gpg' | gpg --dearmor -o /etc/apt/trusted.gpg.d/zerotier.com.gpg
  fi

  # Update apt lists and install package
  apt update
  apt install -y zerotier-one

  # Stop service to change local state path safely
  systemctl stop zerotier-one

  # Ensure persistent folder exists
  mkdir -p "$DATA_DIR"

  # Check if ZeroTier has previously been installed in persistent storage
  if [ ! -L "$ZT_DIR" ] && [ ! -d "$DATA_DIR/zerotier-one" ]; then
    if [ -d "$ZT_DIR" ]; then
      mv "$ZT_DIR" "$DATA_DIR/"
    fi
  fi

  # Handle historical directory setups gracefully
  if [ ! -L "$ZT_DIR" ] && [ -d "$ZT_DIR" ]; then
     rm -rf "$ZT_DIR"
  fi

  # Create symlink from expected location to persistent location
  if [ ! -L "$ZT_DIR" ]; then
     ln -s "$DATA_DIR/zerotier-one" "$ZT_DIR"
  fi

  systemctl start zerotier-one

  # Check if the systemd unit exists (using '>' to prevent file append corruption)
  if [ ! -e "$ZT_SERVICE" ]; then
    # Install systemd service
    cat << 'EOF' > "$ZT_SERVICE"
[Unit]
Description=Upgrade zerotier-one Package via APT
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/apt update && /usr/bin/apt install -y zerotier-one
SuccessExitStatus=0 2
EOF
  fi

  # Check if systemd has a symlink to the service
  if [ ! -L "$SYSD_SERVICE" ]; then
    ln -s "$ZT_SERVICE" "$SYSD_SERVICE"
    systemctl daemon-reload
  fi

  # Check if the systemd timer exists
  if [ ! -e "$ZT_TIMER" ]; then
    # Install systemd timer
    cat << 'EOF' > "$ZT_TIMER"
[Unit]
Description=Weekly attempt to upgrade zerotier-one

[Timer]
OnCalendar=weekly
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF
  fi

  # Check if systemd has a symlink to the timer
  if [ ! -L "$SYSD_TIMER" ]; then
    ln -s "$ZT_TIMER" "$SYSD_TIMER"
  fi

  # Update systemctl regardless to ensure the timer is loaded
  systemctl daemon-reload
  systemctl enable zt_upgrade.timer
  systemctl start zt_upgrade.timer

fi

# Execute if command line argument equals "upgrade"
if [ $# -eq 1 ] && [ "$1" = "upgrade" ]; then
  # Avoid colliding with automated tasks
  wait_for_apt

  apt update
  apt install -y zerotier-one
  systemctl stop zerotier-one
  # Ensure link is maintained
  if [ ! -L "$ZT_DIR" ]; then
     rm -rf "$ZT_DIR"
     ln -s "$DATA_DIR/zerotier-one" "$ZT_DIR"
  fi
  systemctl start zerotier-one
fi

exit 0
